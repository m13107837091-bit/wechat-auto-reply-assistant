# ============================================================
# 微信自动回复助手 - 环境变量示例
# 使用方法：复制本文件为 .env，然后填入真实值。
# 注意：.env 已被 .gitignore 忽略，切勿提交含真实密钥的 .env。
# ============================================================

# 大模型提供方：openai（任意 OpenAI 兼容接口）| ollama（本地模型）
LLM_PROVIDER=openai

# OpenAI 兼容接口地址。留空则使用 config.yaml 中 llm.base_url 的值。
# --- DeepSeek（推荐，便宜好用）---
LLM_BASE_URL=https://api.deepseek.com
# --- 其他 OpenAI 兼容服务示例 ---
# LLM_BASE_URL=https://api.openai.com/v1
# --- Ollama 本地示例（需先 ollama serve 并拉取模型）---
# LLM_BASE_URL=http://localhost:11434/v1

# API Key。Ollama 本地模式可以随便填（例如 ollama）。
LLM_API_KEY=sk-在这里填入你的key

# 模型名。
# DeepSeek 示例：
LLM_MODEL=deepseek-chat
# Ollama 本地示例：
# LLM_MODEL=qwen2.5:7b

# 联网搜索（可选，用于增强天气/新闻/股价等实时类问题的回复）。
# 留空则程序不启用搜索、照常直接回复。
SEARCH_PROVIDER=tavily
# Tavily 搜索的 API Key（https://tavily.com 有免费额度）。Ollama 等不需要可不配。
SEARCH_API_KEY=

# ============================================================
# 控制面板（手机/远程访问时才需要改）
# ============================================================
# 监听地址：127.0.0.1=只本机可访问（默认）；0.0.0.0=同局域网/穿透的设备也能访问。
UI_HOST=127.0.0.1

# 访问令牌：留空=不鉴权（仅本机用足够）；一旦要让手机等外部设备访问，务必设一个随机长串。
# 生成示例：python -c "import secrets;print(secrets.token_urlsafe(24))"
# 设置后，手机打开 http://<电脑IP>:8000/?token=<你设的令牌> 即可（令牌会记在手机浏览器里）。
UI_TOKEN=